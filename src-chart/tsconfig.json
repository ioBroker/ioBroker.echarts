{
    "compilerOptions": {
        "skipLibCheck": true,
        // TypeScript 6 turns `strict` on by default; this project predates that. Keep it off
        // so the React 19 upgrade stays scoped — enabling it is a separate refactor.
        "strict": false,
        "moduleResolution": "Bundler",
        "module": "esnext",
        "target": "esnext",
        "checkJs": false,
        "allowJs": true,
        // Vite produces the bundle; tsc here is only a type-check gate (buildReact runs it
        // with tsc:true). With emit on it also wrote plain JS into ./build, which the copy
        // globs then shipped into admin/ as dead files next to the real assets/ bundle.
        "noEmit": true,
        "rootDir": "./src",
        "noImplicitAny": true,
        // align with backend root tsconfig so shared ChartModel/ChartOption lint identically
        "useUnknownInCatchVariables": false,
        "lib": ["es2018", "DOM"],
        "jsx": "react",
        "types": ["@iobroker/types"]
    },
    "include": ["./src/**/*"],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
