// Root tsconfig to set the settings and power editor support for all TS files
{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        // do not compile anything. This file is just to configure type checking
        "noEmit": true,
        // check JS files
        "allowJs": true,
        "checkJs": true,
        "outDir": "./build/",
        "rootDir": "./src",
        "sourceMap": true,
        "inlineSources": true,

        // This is necessary for the automatic typing of the adapter config
        "resolveJsonModule": true,
        // TypeScript 6 turns `strict` on by default. This project was written against the
        // pre-6 defaults (noImplicitAny only), so pin it — switching strict on is a separate
        // refactor worth ~200 errors in src/lib alone.
        "strict": false,
        "noImplicitAny": true,
        "useUnknownInCatchVariables": false,
        "target": "ES2022",
        "types": ["node", "@iobroker/types"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules/**", "www/**", "lib/**", "build/**", "tasks.js"]
}
